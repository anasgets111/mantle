#!/usr/bin/env bash
# The half of `just check` a commit can affect, picked from the staged paths:
#
# - Rust: anything the crates compile or their tests read. `lua-meta/` and `share/starter/shell.lua`
#   are `include_str!`'d.
#   `pam_worker.rs` reads `packaging/pam.d`: that one subdirectory, not `packaging/` whole, which
#   will hold files no test opens.
# - Docs: `docs/**/*.md` and `docs/images/` are read only by the stub goldens and the docs-example
#   test, so a docs-only commit runs those two, not the whole suite.
# - Lua: any `.lua`, `.luarc.json`, `.editorconfig`, or the formatter.
# - Everything else, this hook and the justfile included: nothing.
#
# Runs on the staged tree: `just staged-only` sets unstaged edits aside for the run.
#
# A stale `lua-meta` stub or generated docs page is regenerated and the commit refused rather than
# staged.
#
# Install with `just hooks`. Skip once with `git commit --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Deletions stay in: removing a Lua file a component `require`s is what the Lua tests are for.
staged="$(git diff --cached --name-only -z | tr '\0' '\n')"
rust=false docs=false lua=false
grep -qE '^docs/(.*\.md|images/.*)$' <<<"$staged" && docs=true
# Not `grep -q` after a pipe: it exits on the first match, and pipefail reads the SIGPIPE as no match.
if grep -vE '\.md$' <<<"$staged" |
    grep -E '\.rs$|(^|/)Cargo\.(toml|lock)$|^rustfmt\.toml$|^\.cargo/|^(renderer|supervisor|shared|lua-meta)/|^packaging/pam\.d/|^share/starter/shell\.lua$' >/dev/null; then
    rust=true
fi
if grep -qE '\.lua$|(^|/)\.luarc\.json$|^\.editorconfig$|^tools/luafmt\.py$' <<<"$staged"; then
    lua=true
fi
$rust || $docs || $lua || exit 0

if ! command -v cargo >/dev/null || ! command -v just >/dev/null; then
    echo "pre-commit: cargo or just missing, skipping the checks" >&2
    exit 0
fi

if [ -z "${STAGED_ONLY:-}" ]; then
    STAGED_ONLY=1 exec just staged-only "$0"
fi

fail() {
    echo "pre-commit: $1 failed. Fix it, or commit with --no-verify and own that." >&2
    exit 1
}

if $rust || $docs; then
    # The docs pages with a generated property table are among `docs/**/*.md`.
    generated() { cat lua-meta/*.lua docs/*/*.md renderer/src/check_samples.json | git hash-object --stdin; }
    before="$(generated)"
    # Almost always a build error rather than the generator: this is the first compile after an
    # edit, so stderr stays on screen. Only the pass list is noise.
    UPDATE_STUBS=1 cargo test --quiet -p supervisor -p renderer the_generated_ >/dev/null ||
        fail "the stub regeneration (just stubs)"
    if [ "$before" != "$(generated)" ]; then
        echo "pre-commit: generated stubs or pages were stale and have been regenerated. Review them, then: git add lua-meta docs renderer/src/check_samples.json" >&2
        exit 1
    fi
fi
if $rust; then
    just fmt-check || fail "cargo fmt --check"
    just test lint rustdoc || fail "the Rust checks"
elif $docs; then
    cargo test --quiet -p renderer every_lua_block_in_the_docs || fail "the docs examples"
fi

if $lua; then
    # No luafmt call here: `just lua` formats as well as parses.
    just lua types || fail "the Lua checks"
fi
