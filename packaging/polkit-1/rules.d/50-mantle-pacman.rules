// One approval per AUR helper run (ADR-0250). pkexec's subject is its caller, so the kept
// authorization covers only the helper process that asked. PATH order decides which pacman path.
polkit.addRule(function (action, subject) {
    var program = action.lookup("program");
    if (action.id == "org.freedesktop.policykit.exec" &&
        (program == "/usr/bin/pacman" || program == "/usr/sbin/pacman") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.AUTH_ADMIN_KEEP;
    }
});
